{
  "name": "zoomout",
  "private": true,
  "version": "0.0.0",
  "description": "ZoomOut — non-fiction books as gamified, interactive micro-lessons",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@zoomout/shared",
    "prebuild": "npm run build:shared",
    "build": "npm run build --workspace=apps/backend && npm run build --workspace=apps/mobile",
    "pretypecheck": "npm run build:shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:shared",
    "test": "npm run test --workspaces --if-present",
    "prelint": "npm run build:shared",
    "lint": "eslint .",
    "prelint:fix": "npm run build:shared",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=apps/backend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:mobile": "npm run dev --workspace=apps/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.10"
  }
}
