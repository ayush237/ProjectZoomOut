{
  "expo": {
    "name": "ZoomOut",
    "slug": "zoomout",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "//userInterfaceStyle": "Must be 'automatic'. Anything else pins the OS appearance the app is told about, so useColorScheme() never reports dark and the whole light/dark system silently resolves to one theme — which is what it did until WP6 caught it in the simulator.",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zoomout.app"
    },
    "android": {
      "package": "com.zoomout.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset"
    ]
  }
}
