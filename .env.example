# ZoomOut — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every variable the backend reads is listed here; the config module (see
# apps/backend/src/config/env.ts) validates them at boot and refuses to start if any
# are missing or malformed.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# Port the backend HTTP server binds to.
PORT=3000

# Interface the server binds to. Use 0.0.0.0 in a container, 127.0.0.1 locally.
HOST=127.0.0.1

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Full Postgres connection string. Drizzle uses this for both migrations and runtime.
# Local development via Docker:
#   docker run --name zoomout-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=zoomout -p 5432:5432 -d postgres:16
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/zoomout

# Seconds to wait for a connection before the pool gives up.
DATABASE_CONNECTION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Authentication (apps/backend)
# ---------------------------------------------------------------------------

# Signs access tokens. Must be at least 32 characters. No default — the backend
# refuses to start without it, and refuses to start if it is still this placeholder.
# Generate one with:  openssl rand -base64 48
AUTH_JWT_SECRET=replace-me-with-at-least-32-random-characters

# Access token lifetime. Short by design: an access token cannot be revoked, so this
# is what bounds the damage if one leaks.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime. Long-lived, but single-use and revocable — presenting an
# already-rotated token revokes the whole session family.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Minimum signup age, in years. Configurable because the legal threshold is still
# undecided (project/LEGAL.md) — when it is settled this is an environment change,
# not a code change.
AUTH_MINIMUM_AGE_YEARS=13

# Client identifiers at Apple and Google, checked as the `aud` claim on incoming ID
# tokens. Optional: leave unset until the apps are registered. An unconfigured
# provider rejects every token rather than skipping the audience check.
# AUTH_APPLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_ID=

# Requests per IP per window on /auth/signup, /auth/login, /auth/provider, /auth/refresh.
# /auth/logout is deliberately not rate limited — it is idempotent and only ends the
# caller's own session.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# How often expired refresh tokens are swept from the database. Only *expired* rows
# are removed; revoked-but-unexpired rows are retained because they are what makes
# refresh-token reuse detection work.
AUTH_TOKEN_REAP_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# CMS (apps/admin — Payload)
# ---------------------------------------------------------------------------

# Signs Payload's admin auth tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Rotating this invalidates every admin session — that is the intended emergency lever.
PAYLOAD_SECRET=replace-me-with-at-least-32-random-characters

# Payload's OWN database. Same Postgres instance as the app, different database.
# Payload manages its own migrations and its own internal schema, so it must not share
# a namespace with the Drizzle-managed tables above.
#   createdb zoomout_cms      (or:  docker exec zoomout-postgres createdb -U postgres zoomout_cms)
PAYLOAD_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/zoomout_cms
