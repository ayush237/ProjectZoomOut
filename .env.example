# ZoomOut — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every variable the backend reads is listed here; the config module (see
# apps/backend/src/config/env.ts) validates them at boot and refuses to start if any
# are missing or malformed.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# One of: development | test | production
NODE_ENV=development

# Port the backend HTTP server binds to.
PORT=3000

# Interface the server binds to. Use 0.0.0.0 in a container, 127.0.0.1 locally.
HOST=127.0.0.1

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Full Postgres connection string. Drizzle uses this for both migrations and runtime.
# Local development via Docker:
#   docker run --name zoomout-postgres -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=zoomout -p 5432:5432 -d postgres:16
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/zoomout

# Seconds to wait for a connection before the pool gives up.
DATABASE_CONNECTION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Authentication (apps/backend)
# ---------------------------------------------------------------------------

# Signs access tokens. Must be at least 32 characters. No default — the backend
# refuses to start without it, and refuses to start if it is still this placeholder.
# Generate one with:  openssl rand -base64 48
AUTH_JWT_SECRET=replace-me-with-at-least-32-random-characters

# Access token lifetime. Short by design: an access token cannot be revoked, so this
# is what bounds the damage if one leaks.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime. Long-lived, but single-use and revocable — presenting an
# already-rotated token revokes the whole session family.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Minimum signup age, in years. Configurable because the legal threshold is still
# undecided (project/LEGAL.md) — when it is settled this is an environment change,
# not a code change.
AUTH_MINIMUM_AGE_YEARS=13

# Client identifiers at Apple and Google, checked as the `aud` claim on incoming ID
# tokens. Optional: leave unset until the apps are registered. An unconfigured
# provider rejects every token rather than skipping the audience check.
# AUTH_APPLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_ID=

# Requests per IP per window on /auth/signup, /auth/login, /auth/provider, /auth/refresh.
# /auth/logout is deliberately not rate limited — it is idempotent and only ends the
# caller's own session.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# How often expired refresh tokens are swept from the database. Only *expired* rows
# are removed; revoked-but-unexpired rows are retained because they are what makes
# refresh-token reuse detection work.
AUTH_TOKEN_REAP_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Content delivery (apps/backend reading from the CMS)
# ---------------------------------------------------------------------------

# Base URL of Payload's REST API. The backend calls it anonymously over private
# networking — Payload returns published-only to unauthenticated callers, which is
# what makes takedown work. There is deliberately no admin token here: adding one
# would widen those reads to include drafts.
CONTENT_API_URL=http://127.0.0.1:3001/api

# Per-request timeout. A slow CMS must become a fast 503, never a hung backend.
CONTENT_API_TIMEOUT_MS=5000

# How long a content response may be reused from memory.
# THIS VALUE IS THE TAKEDOWN LATENCY — an unpublished Track stays visible for up to
# this long. LEGAL.md commits to hours; minutes clears that comfortably. Capped at
# 600 in the config schema so it cannot quietly become a number that would not.
CONTENT_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# CMS (apps/admin — Payload)
# ---------------------------------------------------------------------------

# Signs Payload's admin auth tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
# Rotating this invalidates every admin session — that is the intended emergency lever.
PAYLOAD_SECRET=replace-me-with-at-least-32-random-characters

# Payload's OWN database. Same Postgres instance as the app, different database.
# Payload manages its own migrations and its own internal schema, so it must not share
# a namespace with the Drizzle-managed tables above.
#   createdb zoomout_cms      (or:  docker exec zoomout-postgres createdb -U postgres zoomout_cms)
PAYLOAD_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/zoomout_cms

# Progress and XP
XP_LEAF_COMPLETION=80
XP_FIRST_TRY_BONUS=20

# --- Mobile app (apps/mobile) ---
# Expo inlines every EXPO_PUBLIC_* variable into the bundle at build time, so
# nothing secret may go here. All three below are public by design.

# The backend base URL the app talks to.
# The built-in default is http://127.0.0.1:3000, which is correct on a simulator
# (it shares the Mac network stack) and WRONG on a physical device, where it
# resolves to the phone itself and every request fails as a NetworkError. Set this
# to your Mac's LAN address when running on hardware, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Social sign-in is deferred to post-Phase-1 (roadmap, 2026-08-11). Both settings
# below are off, and the buttons do not render while they are.

# Google OAuth client id for iOS. Unset means the Google button is hidden.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple. Only the exact string "true" enables it. Do not turn this on
# without the com.apple.developer.applesignin entitlement — the button would render
# and then fail at the system sheet. Note App Store Guideline 4.8: if Google ships,
# Apple must ship with it.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false

# --- CMS seed script (apps/admin, `npm run seed --workspace=apps/admin`) ---
# Only needed to run the placeholder seed. Not read by any running service.

# Where the Payload CMS is listening. Defaults to http://127.0.0.1:3001.
PAYLOAD_URL=http://127.0.0.1:3001

# A CMS operator account. The seed signs in and writes through the same authenticated
# path an author would, so every validation hook and publish rule fires — a seed that
# bypassed them would prove nothing about whether the content is valid.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Session cap (WP5a). Fifteen minutes or 500 XP, whichever comes first.
SESSION_CAP_SECONDS=900
SESSION_CAP_XP=500
# Most any one Leaf may add to the daily clock, so an abandoned Leaf cannot spend it all.
SESSION_MAX_LEAF_SECONDS=300
