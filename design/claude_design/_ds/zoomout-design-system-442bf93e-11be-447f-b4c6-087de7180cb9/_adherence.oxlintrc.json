{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/graph/**",
              "components/lesson/**",
              "components/navigation/**",
              "components/rewards/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Nunito, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|primary|reward|correct|incorrect)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'primary' | 'reward' | 'correct' | 'incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconPosition|disabled|fullWidth|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconPosition, disabled, fullWidth, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconPosition'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Button> iconPosition must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|padding|radius|interactive|bordered|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, padding, radius, interactive, bordered, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:page|card|raised)$/]",
        "message": "<Card> elevation must be one of 'page' | 'card' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|children|style|key|ref|className|style|children)$/]",
        "message": "<FeedbackNote> doesn't accept that prop. Declared props: kind, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedbackNote'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:correct|incorrect|info)$/]",
        "message": "<FeedbackNote> kind must be one of 'correct' | 'incorrect' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|label|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, label, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|iconSize|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, iconSize, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|secondary)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|helper|error|icon|type|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, placeholder, helper, error, icon, type, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|password|search)$/]",
        "message": "<Input> type must be one of 'text' | 'email' | 'password' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LockedPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:unlocked|title|hint|children|style|key|ref|className|style|children)$/]",
        "message": "<LockedPanel> doesn't accept that prop. Declared props: unlocked, title, hint, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|state|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<OptionButton> doesn't accept that prop. Declared props: children, index, state, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionButton'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|selected|correct|incorrect)$/]",
        "message": "<OptionButton> state must be one of 'default' | 'selected' | 'correct' | 'incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|label|valueLabel|height|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, label, valueLabel, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|reward)$/]",
        "message": "<ProgressBar> tone must be one of 'primary' | 'reward'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|children|footer|tone|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: kind, title, children, footer, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|primary|reward|correct|incorrect)$/]",
        "message": "<SlideFrame> tone must be one of 'neutral' | 'primary' | 'reward' | 'correct' | 'incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<SlideProgress> doesn't accept that prop. Declared props: current, total, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickyNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|children|style|key|ref|className|style|children)$/]",
        "message": "<StickyNote> doesn't accept that prop. Declared props: index, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|size|label|style|key|ref|className|style|children)$/]",
        "message": "<StreakBadge> doesn't accept that prop. Declared props: days, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreakBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<StreakBadge> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|label|description|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, label, description, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: key, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|onBack|backLabel|actionIcon|actionLabel|onAction|sticky|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, subtitle, onBack, backLabel, actionIcon, actionLabel, onAction, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|author|leavesDone|leavesTotal|nodes|onOpen|style|key|ref|className|style|children)$/]",
        "message": "<TrackCard> doesn't accept that prop. Declared props: title, author, leavesDone, leavesTotal, nodes, onOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackGraphNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|state|key|ref|className|style|children)$/]",
        "message": "<TrackGraphNode> doesn't accept that prop. Declared props: id, label, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackGraphNode'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|current|locked)$/]",
        "message": "<TrackGraphNode> state must be one of 'done' | 'current' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='XpChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|variant|animate|style|key|ref|className|style|children)$/]",
        "message": "<XpChip> doesn't accept that prop. Declared props: amount, variant, animate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='XpChip'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|soft)$/]",
        "message": "<XpChip> variant must be one of 'solid' | 'soft'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
