# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Next.js (apps/admin)
.next/
next-env.d.ts

# Test output
coverage/

# Expo / React Native
.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Python (apps/pipeline) — the pipeline is a standalone Python project.
# These are unanchored so they hold on every branch regardless of eslint config:
# an untracked .venv already produced 26 phantom lint errors and sits one
# `git add .` away from committing a virtualenv.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Pipeline run artefacts — book text, embeddings scratch, per-run output
apps/pipeline/.data/
apps/pipeline/runs/

# Editors and OS
.DS_Store
.idea/
*.swp

# Claude Code local overrides
.claude/settings.local.json
