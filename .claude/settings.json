{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/secrets/**)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(docker exec zoomout-postgres psql:*)",
      "Read(./apps/mobile/.env)",
      "Edit(./apps/mobile/.env)",
      "Bash(lsof *)",
      "Bash(kill *)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(lsof *)",
      "Bash(kill *)"
    ]
  }
}
